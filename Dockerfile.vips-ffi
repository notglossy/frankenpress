# Define build arguments that can be overridden at build time
ARG WORDPRESS_VERSION=latest
ARG PHP_VERSION=8.4
# Only trixie is supported: the libheif AOM plugin packages below don't exist
# in older Debian releases.
ARG DEBIAN_VERSION=trixie
# Base FrankenPress image. Defaults to the published tag; CI overrides it on
# pull requests to build on top of the base image built from the PR.
ARG BASE_IMAGE=ghcr.io/notglossy/frankenpress:php-${PHP_VERSION}-${DEBIAN_VERSION}

FROM ${BASE_IMAGE}

USER root

RUN apt-get update && apt-get install -y --no-install-recommends \
	libvips42 \
	libheif1 \
	libaom3 \
	libheif-plugin-aomdec \
	libheif-plugin-aomenc \
	&& install-php-extensions ffi \
	&& rm -rf /var/cache/apt/archives \
	&& rm -rf /var/lib/apt/lists/*

ADD https://github.com/notglossy/vips-image-editor-ffi/releases/download/v3.1.0/vips-image-editor-ffi-3.1.0.zip /tmp/vips-image-editor-ffi.zip
RUN unzip /tmp/vips-image-editor-ffi.zip -d /usr/src/wordpress/wp-content/plugins/ \
	&& rm -rf /tmp/vips-image-editor-ffi.zip \
	&& echo 'zend.max_allowed_stack_size=-1' >> /usr/local/etc/php/conf.d/stack-size.ini \
	&& echo 'ffi.enable=true' >> /usr/local/etc/php/conf.d/docker-php-ext-ffi.ini

USER www-data
